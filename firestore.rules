rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the current user is an Admin
    function isAdmin() {
      // Since the admin doc is u-admin, we check if the doc u-admin has uid matching request.auth.uid
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/u-admin) &&
        get(/databases/$(database)/documents/users/u-admin).data.uid == request.auth.uid;
    }

    // Rules for the golf ball catalog collection
    match /catalog/{itemId} {
      // Anyone (even guest/unauthenticated users) can read the catalog
      allow read: if true;
      
      // Only users with the Admin role can create, update, or delete catalog items
      allow write: if isAdmin();
    }

    // Rules for the users collection
    match /users/{userId} {
      // Allow user to get/write their own profile if they are logged in and their Auth UID matches the document's internal uid field
      allow read, write: if (request.auth != null && (
        // For existing documents (read/update/delete)
        (resource != null && resource.data.uid == request.auth.uid) ||
        // For new/modified documents (create/write)
        (request.resource != null && request.resource.data.uid == request.auth.uid)
      )) || isAdmin();

      // Rules for nested user collections (e.g., users/{userId}/data/locker)
      match /data/{document=**} {
        // Users can read/write their own locker data by checking the parent user doc's uid field.
        allow read, write: if (request.auth != null && 
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid
        ) || isAdmin();
      }
    }
  }
}

