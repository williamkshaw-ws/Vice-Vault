rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the current user is an Admin.
    // Dynamically checks the 'role' field on the requesting user's own document,
    // so any user promoted to Admin via the server gains Firestore write access too.
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Admin";
    }

    // Rules for the golf ball catalog collection
    match /catalog/{itemId} {
      // Anyone (even guest/unauthenticated users) can read the catalog
      allow read: if true;
      
      // Only users with the Admin role can create, update, or delete catalog items
      allow write: if isAdmin();
    }

    // Rules for the users collection
    match /users/{userId} {
      // Allow user to get/write their own profile
      allow read, write: if isAdmin() || (request.auth != null && (
        userId == request.auth.uid ||
        (resource == null || resource.data.uid == request.auth.uid || resource.data.authUid == request.auth.uid)
      ));

      // Rules for locker subcollection
      match /locker/{document=**} {
        allow read, write: if (request.auth != null && (
          userId == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(userId)) &&
           (get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid ||
            get(/databases/$(database)/documents/users/$(userId)).data.authUid == request.auth.uid))
        )) || isAdmin();
        
        // Allow public read if parent user has shareBag true
        allow read: if exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.shareBag == true;
      }

      // Rules for nested user data (rounds, settings, legacy locker)
      match /data/{document=**} {
        allow read, write: if (request.auth != null && (
          userId == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(userId)) &&
           (get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid ||
            get(/databases/$(database)/documents/users/$(userId)).data.authUid == request.auth.uid))
        )) || isAdmin();
        
        // Allow public read if parent user has shareBag true
        allow read: if exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.shareBag == true;
      }
    }
  }
}

